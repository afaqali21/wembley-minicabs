{
  "name": "wembley-minicabs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i src/app/input.css -o src/app/globals.css --minify",
    "watch:css": "tailwindcss -i src/app/input.css -o src/app/globals.css --watch",
    "dev": "tailwindcss -i src/app/input.css -o src/app/globals.css && next dev",
    "build": "tailwindcss -i src/app/input.css -o src/app/globals.css --minify && next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "postcss": "^8.5.33",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
